{
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
        "App\\": "app/"
    }
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^2.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
